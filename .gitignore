# Build output. Never committed, from the first commit.
# The sibling repo commits its build output and its .git is 34 MB against a
# packed size of 862 KiB, because Vite content-hashes filenames so every build
# writes new blobs that never delta-compress. Only fixable by rewriting history.
dist/
build/
out/
docs-build/
.vite/

# Dependencies
node_modules/
.pnp
.pnp.js

# Expo
.expo/
.expo-shared/
*.jks
*.p8
*.p12
*.key
*.mobileprovision

# Environment. VITE_ values are public by design, but the file itself is not.
.env
.env.local
.env.*.local

# Supabase local
supabase/.branches
supabase/.temp
.branches
.temp

# Test and coverage output
coverage/
.nyc_output/
packages/validators/results/*.json
!packages/validators/results/.gitkeep

# Python sidecar
__pycache__/
*.py[cod]
.venv/
venv/

# Editor and OS
.DS_Store
Thumbs.db
.idea/
*.swp
.vscode/*
!.vscode/extensions.json

# Logs
*.log
npm-debug.log*

# Scratch from scaffold delivery. Safe to delete.
_scaffold.zip

# Raw capture staging. Triaged copies live in docs/reference/, which is committed.
# Keeping both would double roughly 27 MB of PNGs in .git. See D1.
reference images/

# Local CLI tool deps
tools/blueberry-ai/node_modules/
tools/blueberry-ai/dist/
tools/blueberry-ai/fixtures/.work.css

# TypeScript incremental build state. Churns every build, never useful in history.
*.tsbuildinfo
# Declaration-only emit from composite app projects (apps/web outDir).
tsbuild/

# Mutation testing scratch. The distilled score in packages/chem-core/mutation/last-run.json
# is committed evidence; the full Stryker report is a large machine artifact and is not.
.stryker-tmp/
packages/chem-core/mutation/stryker-report.json

# Single file preview build, never committed
dist-single/

# Reference clones, local only. Three third party repos pulled for the Phase 5
# surfaces: sanidhyy/duolingo-clone, jokerhutt/ludolang, jokerhutt/ludolang-backend.
# 5.9 MB of someone else's code and their licences, not ours to vendor, and D1 is
# about repo size. Re-clone from the URLs in
# docs/reference/competitors/WEB-INSPIRATION.md.
docs/reference/competitors/repos/

# Agent worktrees. A full checkout of this repo inside itself; committing it
# would nest the tree in its own history.
.claude/worktrees/

# Throwaway measurement probes and their output.
#
# The convention is that an underscore prefix means SCRATCH: a probe written to
# answer one question in one session (does the header overlap, what does this
# 404, what is the painted contrast of that chip). They are worth writing and
# not worth keeping, because the next question wants a different probe and a
# directory of forty stale ones is worse than none. A probe that earns a second
# use gets renamed without the underscore and committed, which is how
# board-capture.mjs got there.
apps/web/measurements/_*.mjs
apps/web/measurements/_sheets/
apps/web/measurements/board/
apps/web/_*.tmp.mjs

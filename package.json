{
  "name": "blueberry-mechanisms",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "engines": {
    "node": ">=20.11"
  },
  "scripts": {
    "typecheck": "tsc -b packages/chem-core packages/feedback packages/validators",
    "test": "npm run test --workspaces --if-present",
    "validate": "npm run validate -w packages/validators",
    "lock:check": "npm run lock:check -w packages/validators",
    "lock:regen": "npm run lock:regen -w packages/validators",
    "build": "tsc -b packages/chem-core packages/feedback packages/validators"
  },
  "devDependencies": {
    "typescript": "^5.8.3",
    "vitest": "^3.2.4"
  }
}
